# =============================================================================
# GlucoProfile — Environment Variables Template
#
# Copy this file to .env and fill in the values for your local environment.
#   cp .env.example .env
#
# IMPORTANT: Never commit the real .env file. It is excluded by .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker UID/GID (match your local user to avoid volume permission issues)
# Run: id -u  and  id -g  to find your values
# -----------------------------------------------------------------------------
APP_UID=1000
APP_GID=1000
AIRFLOW_UID=1000

# -----------------------------------------------------------------------------
# Application PostgreSQL database
# -----------------------------------------------------------------------------
POSTGRES_DB=gluco_db
POSTGRES_USER=your_pg_user_here
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Airflow metadata PostgreSQL database
# -----------------------------------------------------------------------------
AIRFLOW_POSTGRES_DB=airflow_db
AIRFLOW_POSTGRES_USER=your_airflow_pg_user_here
AIRFLOW_POSTGRES_PASSWORD=replace_me
AIRFLOW_POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# MLflow backend PostgreSQL database
# -----------------------------------------------------------------------------
MLFLOW_POSTGRES_DB=mlflow_db
MLFLOW_POSTGRES_USER=your_mlflow_pg_user_here
MLFLOW_POSTGRES_PASSWORD=replace_me
MLFLOW_POSTGRES_PORT=5434

# -----------------------------------------------------------------------------
# pgAdmin web UI
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=your_email@example.com
PGADMIN_PASSWORD=replace_me
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# MLflow tracking server
# -----------------------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=GlucoProfile
MLFLOW_MODEL_NAME=GlucoProfileClassifier
MLFLOW_MODEL_STAGE=Production
MLFLOW_PRODUCTION_ALIAS=production

# -----------------------------------------------------------------------------
# FastAPI inference service
# -----------------------------------------------------------------------------
FASTAPI_PORT=8000
API_ADMIN_KEY=replace_me

# -----------------------------------------------------------------------------
# Streamlit practitioner dashboard
# -----------------------------------------------------------------------------
STREAMLIT_PORT=8501

# -----------------------------------------------------------------------------
# Apache Airflow
# -----------------------------------------------------------------------------
AIRFLOW_VERSION=3.3.1
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace_me

# Fernet key for encrypting secrets in the Airflow DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_me_with_a_valid_fernet_key_at_least_32_chars

# JWT and API secret keys — use long random strings (>= 32 characters)
AIRFLOW_JWT_SECRET=replace_me_jwt_secret_at_least_32_characters_long
AIRFLOW_API_SECRET_KEY=replace_me_api_secret_key_at_least_32_chars